{
  "name": "music-story",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run check:size",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:boundary": "vitest run tests/ai-boundary.test.ts",
    "test:cache": "vitest run tests/two-member-cache.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:size": "node scripts/check-route-size.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.27",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serwist": "9.5.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
