# Database Configuration (PRD Section 7.8, 7.9, 9.4)
# Provider: PostgreSQL on Neon with pgvector extension
DATABASE_URL="postgresql://username:password@ep-example-pooler.region.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-example.region.neon.tech/neondb?sslmode=require"

# Auth & Session (PRD Section 7.3)
BETTER_AUTH_SECRET="your-32-character-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# Scheduled Maintenance & Security (PRD Section 7.4, security-and-secrets.md)
CRON_SECRET="your-cron-secret-header-key"

# Cloudflare Workers AI (PRD Section 8.6, 9.5)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
